    main.elements[field].value = new_val; 
    main.elements[field].readOnly = true; 
    main.elements[field].className='notouch'; 
  } 
}

// The HidCheck function uses a hidden element to maintain a checkbox status.  
// See checkbox form element at bottom of page.
