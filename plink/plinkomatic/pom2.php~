// Set regular form element value to saved value ($flag) if available, 
// otherwise to the default value.
function FlagDisp($flag, $default)
{
	if(isset($flag)) 
		{echo "value=".$flag;}
	else
		{echo "value=".$default;}
}  

// Set optional form element value to the saved value if available, 
// otherwise set to default and make readonly.  (See Optional Flag example) 
function FlagDispCheck($check, $flag, $default)
{  
	if($check=="yes")
		{ echo "value=".$flag." class='normal'"; }
	else 
	{ 
		echo "value=".$default. " readOnly ";
		echo " class='notouch' ";
	}
} 

// Check checkbox form element based on hidden field. (See checkbox example)
function Check_Display($check)
{
	if($check=="yes") 
		{echo "CHECKED";}
} 


// Check correct radio element.  (See radio example)
function SetRadio($flag, $value)
{ 
	if ($flag==$value)
		{echo "checked";}
}


