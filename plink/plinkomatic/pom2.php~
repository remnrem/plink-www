{ 
	if (obj_checkbox.checked) 
		{obj_checkbox.main.elements[hidcheck].value ="yes";}
	else
		{obj_checkbox.main.elements[hidcheck].value ="no";}
}
 
function Reading(field)
{
	main.elements[field].readOnly = true; 
   main.elements[field].className='notouch';
}

// -->
