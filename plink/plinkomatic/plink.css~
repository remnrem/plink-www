/* overall styles */
body
        {
                font:                   11pt sans-serif;
                margin-top:             0.5em;
                margin-bottom:          0.5em;
                margin-left:            2;
                margin-right:           1;
                color:                  black;
                line-height:            1.7em;
                text-decoration:        none;
        }


/* this is the alert/warning flag */
strong
        {
                border:                 1px solid #000000;
                padding-bottom:         1;
                padding-top:            1;
                padding-right:          20;
                padding-left:           20;
                margin-left:            1px;
                margin-top:             5em;
                margin-bottom:          2px;
                background:             #EE7777;
                font-size:              100%;
                font-weight:            normal;                                                                                                                                
        }


/* this is the indenting procedure for categories */
kbd
        {
                border-left:            1px dotted #000000;
                padding-bottom:         2;
                padding-top:            0;
                padding-right:          20;
                padding-left:           20;
                margin-left:            20px;
                margin-right:           100px;
                margin-top:             3em;
                margin-bottom:          -1px;
                background:             #EEEEEE;
		font-size:		90%;
		font-family:		courier;
        }
                                                                              

/* this is the indenting procedure for major categories */
h1
        {
                border:  1px ;
                border-left: 2px solid #225522;
                border-top: 2px solid #225522;
                margin-left:            0;
                margin-right:           100;
                padding-left:  5;
                padding-right:  20;
                background:     #f0f5f0;
                text-align: justify;
                font-size: 120%;
        }

/* this is for category headings */
h2
        {
                border:                 1px dotted #000000;
                border-top:             1px dotted #000000;
                border-right:           1px dotted #000000;
                padding-bottom:         2;
                padding-top:            0;
                padding-right:          20;
                padding-left:           20;
                margin-left:            0px;
                margin-top:             3em;
                margin-bottom:          -1px;
                background:             #335522;
                font-size:              120%;
		color:                  #FFFFFF;
                font-weight:            normal;
                                                                                                                                
        }


img.logo
        {
                margin-top:     1em;
                margin-left:    10px;
                border:         12px;
                float:          right;
                text-decoration:        none;

        }

img
        {
                border: 0;
		text-decoration:        none;
        }
                                                                                                                                






input[type="image"]
{
      border: 0;
}
                                                                                                                                




